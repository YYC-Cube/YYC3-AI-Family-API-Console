{
  "name": "yyc3-ai-family-api-console",
  "version": "1.0.0",
  "private": true,
  "description": "YYC³ AI Family Token Console — 统一模型网关 · 可观测 · 可调试 · 八智能体协同控制台",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "contract:check": "node scripts/contract/check.mjs",
    "contract:freeze": "node scripts/contract/check.mjs freeze",
    "test:e2e": "playwright test e2e/specs",
    "test:visual": "playwright test e2e/visual.spec.ts e2e/visual-badges.spec.ts e2e/visual-routes.spec.ts",
    "test:visual:update": "playwright test e2e/visual.spec.ts e2e/visual-badges.spec.ts e2e/visual-routes.spec.ts --update-snapshots",
    "test:a11y": "playwright test e2e/specs/a11y.spec.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "^4.10.0",
    "oxfmt": "^0.68.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  },
  "packageManager": "pnpm@11.10.0"
}
