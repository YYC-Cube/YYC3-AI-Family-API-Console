# ═══ YYC³ AI Family Token Console · .gitignore ═══
# 依赖 Dependencies
node_modules/
.pnpm-store/

# 构建产物 Build outputs
dist/
site/
*.tsbuildinfo

# 环境变量 Environment（密钥不入库 · Zero hardcoded secrets）
.env
.env.*
!.env.example

# 日志与临时文件 Logs & temp
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# 包管理器：源真值 = pnpm-lock.yaml（pnpm import 生成）
# Package manager: single source of truth is pnpm-lock.yaml
package-lock.json
yarn.lock

# Playwright 运行产物 Test artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/
e2e/reports/

# 编辑器与系统 Editor & OS
.idea/
*.swp

# 本地专属目录（不入库 · 仅本地留存 Local-only directories）
docs/YYC3-AI-Family-Token-Console-团队规范/
docs/YYC3-AI-Family-Token-Console-设计核心/
