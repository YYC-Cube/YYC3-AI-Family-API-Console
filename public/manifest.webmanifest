  "edge_side_panel": {
    "default_path": "/dashboard"
  },
  "launch_handler": {
    "client_mode": "auto"
  },
  "protocol_handlers": [
    {
      "protocol": "web+yyc3",
      "url": "/dashboard?from=%s"
    }
  ],
  "file_handlers": [],
  "share_target": {
    "action": "/dashboard",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
